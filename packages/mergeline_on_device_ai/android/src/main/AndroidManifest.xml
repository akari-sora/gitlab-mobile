<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt,com.google.mlkit.genai.common" />
    <!-- deviceSupport() looks up AICore without ML Kit; declare the query here
         rather than relying on the ML Kit manifests to keep providing it. -->
    <queries>
        <package android:name="com.google.android.aicore" />
    </queries>
    <application>
        <!-- Second line of defence: the generated app manifest removes it too.
             ML Kit must not initialise at app start (it sends diagnostics). -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
    </application>
</manifest>
